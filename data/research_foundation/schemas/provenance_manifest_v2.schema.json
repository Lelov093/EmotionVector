{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotionvector.local/schemas/provenance_manifest_v2.schema.json",
  "title": "EmotionVector Dataset Provenance Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "created_at", "entries", "claim_boundary"],
  "properties": {
    "manifest_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"},
      "minItems": 1
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id", "path", "version", "sha256", "row_count", "origin",
        "construction", "license", "annotation", "intended_use", "prohibited_use",
        "disposition", "verified_at", "evidence_level"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "row_count": {"type": "integer", "minimum": 0},
        "origin": {"type": "string", "minLength": 1},
        "upstream_sources": {"type": "array", "items": {"type": "string"}},
        "construction": {"type": "string", "minLength": 1},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "review_status", "source_url", "restrictions"],
          "properties": {
            "identifier": {"type": "string"},
            "review_status": {"enum": ["verified_internal", "provisional", "blocked"]},
            "source_url": {"type": ["string", "null"]},
            "restrictions": {"type": "array", "items": {"type": "string"}}
          }
        },
        "annotation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "independent_human_annotators", "notes"],
          "properties": {
            "status": {"enum": ["none", "ai_preannotated", "secondary_review", "independent_human"]},
            "independent_human_annotators": {"type": "integer", "minimum": 0},
            "notes": {"type": "string"}
          }
        },
        "intended_use": {"type": "array", "items": {"type": "string"}},
        "prohibited_use": {"type": "array", "items": {"type": "string"}},
        "disposition": {"enum": ["historical_candidate", "auxiliary_only", "retired", "eligible_for_v2_review"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "evidence_level": {"enum": ["direct", "indirect", "inference", "unverified"]}
      }
    }
  }
}
