{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotionvector.local/schemas/representation_atlas_v2_result.schema.json",
  "title": "EmotionVector Representation Atlas v2 Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "analysis_plan_version", "dataset_manifest_sha256", "model", "selection",
    "axis_results", "test_access", "negative_results_retained", "evidence_type", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "representation_atlas_v2_result_v0_1"},
    "analysis_plan_version": {"const": "representation_atlas_v2_analysis_plan_v0_1"},
    "dataset_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {
      "type": "object",
      "required": ["model_id", "revision", "dtype", "quantization"],
      "properties": {
        "model_id": {"type": "string"},
        "revision": {"type": "string"},
        "dtype": {"type": "string"},
        "quantization": {"type": ["string", "null"]}
      }
    },
    "selection": {
      "type": "object",
      "required": ["selected_layer", "selected_pooling", "selected_threshold", "selection_splits", "locked_before_test"],
      "properties": {
        "selected_layer": {"type": "integer"},
        "selected_pooling": {"type": "string"},
        "selected_threshold": {"type": "number"},
        "selection_splits": {"const": ["train", "dev"]},
        "locked_before_test": {"const": true}
      }
    },
    "axis_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "axis_id", "split", "pair_count", "effect_size", "effect_size_ci", "auroc",
          "balanced_accuracy", "permutation", "paired_bootstrap", "null_distributions", "controls",
          "probes", "status", "limitations"
        ],
        "properties": {
          "axis_id": {"const": "boundary-preserving-over-accommodating"},
          "split": {"enum": ["train", "dev", "test"]},
          "pair_count": {"type": "integer", "minimum": 1},
          "effect_size": {"type": ["number", "null"]},
          "effect_size_ci": {
            "type": "object",
            "required": ["lower", "upper", "level"],
            "properties": {
              "lower": {"type": ["number", "null"]},
              "upper": {"type": ["number", "null"]},
              "level": {"const": 0.95}
            }
          },
          "auroc": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "balanced_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "permutation": {"type": "object"},
          "paired_bootstrap": {"type": "object"},
          "null_distributions": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "controls": {"type": "array", "minItems": 4, "items": {"type": "object"}},
          "probes": {"type": "array", "minItems": 2, "items": {"type": "object"}},
          "status": {"enum": ["pilot_signal", "exploratory", "not_supported", "invalid"]},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "test_access": {
      "type": "object",
      "required": ["opened_at", "opening_reason", "access_log_sha256"],
      "properties": {
        "opened_at": {"type": "string", "format": "date-time"},
        "opening_reason": {"const": "single_confirmatory_opening_after_train_dev_lock"},
        "access_log_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "negative_results_retained": {"const": true},
    "evidence_type": {"const": "representation_evidence_only"},
    "claim_boundary": {"type": "string"}
  }
}
