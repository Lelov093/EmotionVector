{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emotionvector.local/schemas/artifact_manifest_v2.schema.json",
  "title": "EmotionVector Experiment Artifact Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version", "experiment_id", "created_at", "git_commit", "model",
    "seeds", "environment", "inputs", "outputs", "commands", "claim_boundary"
  ],
  "properties": {
    "manifest_version": {"type": "string"},
    "experiment_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "revision", "quantization", "dtype"],
      "properties": {
        "model_id": {"type": "string"},
        "revision": {"type": "string", "minLength": 1},
        "quantization": {"type": ["string", "null"]},
        "dtype": {"type": "string"}
      }
    },
    "seeds": {"type": "object", "additionalProperties": {"type": "integer"}},
    "environment": {
      "type": "object",
      "required": ["python", "platform", "dependency_lock_sha256"],
      "properties": {
        "python": {"type": "string"},
        "platform": {"type": "string"},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "gpu": {"type": ["string", "null"]}
      }
    },
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "commands": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "tracked"],
      "properties": {
        "artifact_id": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "tracked": {"type": "boolean"}
      }
    }
  }
}
